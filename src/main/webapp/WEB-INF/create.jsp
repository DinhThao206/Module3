<form method="post" action="users?action=create">
    Name: <input name="name"><br>
    Email: <input name="email"><br>
    Country: <input name="country"><br>

    <h4>Permission</h4>
    <input type="checkbox" name="add"> Add
    <input type="checkbox" name="edit"> Edit
    <input type="checkbox" name="delete"> Delete
    <input type="checkbox" name="view"> View

    <br><br>
    <button type="submit">Save</button>
</form>